# Postmark
POSTMARK_SERVER_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
POSTMARK_FROM_EMAIL=hello@meditransfer.ch
POSTMARK_FROM_NAME=Pom Pom GmbH
POSTMARK_STREAM=broadcast
POSTMARK_WEBHOOK_SECRET=change-me

# Unsubscribe / tracking URLs (must be publicly reachable for production sends)
MAILER_BASE_URL=https://mailer.meditransfer.ch
MAILER_TOKEN_SECRET=change-me-to-a-long-random-string

# Storage
MAILER_DB_PATH=./state/mailer.db

# Sender-legal identification (appears in every footer)
SENDER_LEGAL_NAME=Pom Pom GmbH
SENDER_LEGAL_ADDRESS=Pom Pom GmbH, <street>, <zip> <city>, Switzerland
SENDER_REPLY_TO=hello@meditransfer.ch

# Rate cap (sends/minute; Postmark default per-server is 10/s = 600/min)
MAILER_RATE_PER_MINUTE=300
MAILER_DAILY_CAP=500
